{
  "name": "chatbot-demo",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "electron:dev": "concurrently -k -s first \"next dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "build": "next build",
    "build:standalone": "next build && node scripts/copy-standalone.mjs",
    "start": "next start",
    "lint": "next lint",
    "dist": "npm run build:standalone && electron-builder --win",
    "dist:dir": "npm run build:standalone && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "wait-on": "^8.0.5"
  }
}
